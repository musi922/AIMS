{
    "name": "foerderfinder",
    "version": "0.0.1",
    "description": "Förderfinder",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "type": "commonjs",
    "main": "webapp/index.html",
    "scripts": {
        "build": "npm run build:cf",
        "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
        "start": "ui5 serve"
    },
    "devDependencies": {
        "@sap-ux/eslint-plugin-fiori-tools": "9.0.5",
        "@ui5/cli": "4.0.53",
        "eslint": "9.0.0",
        "ui5-task-zipper": "3.6.0",
        "ui5-tooling-transpile": "3.12.0",
        "@sap/ux-ui5-tooling": "1.32.0",
        "typescript": "6.0.3"
    }
}

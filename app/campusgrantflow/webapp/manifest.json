{
    "_version": "1.32.0",
    "sap.app": {
        "id": "grants.campusgrantflow",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "0.0.1"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "dataSources": {
            "mainService": {
                "uri": "/odata/v4/grant-master-data/",
                "type": "OData",
                "settings": {
                    "annotations": [],
                    "odataVersion": "4.0"
                }
            }
        },
        "crossNavigation": {
            "inbounds": {
                "campusgrantflow-display": {
                    "semanticObject": "campusgrantflow",
                    "action": "display",
                    "title": "{{flpTitle}}",
                    "subTitle": "{{flpSubtitle}}",
                    "icon": "sap-icon://survey",
                    "indicatorDataSource": {
                        "dataSource": "mainService",
                        "path": "GrantsMasterData/$count",
                        "refresh": 300
                    },
                    "signature": {
                        "parameters": {},
                        "additionalParameters": "allowed"
                    }
                }
            },
            "outbounds": {
                "GrantApplication-start": {
                    "semanticObject": "GrantApplication",
                    "action": "start"
                }
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "flexEnabled": true,
        "dependencies": {
            "minUI5Version": "1.108.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.ui.layout": {},
                "sap.fe.templates": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "grants.campusgrantflow.i18n.i18n"
                }
            },
            "": {
                "dataSource": "mainService",
                "preload": true,
                "settings": {
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            },
            "@i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "uri": "i18n/i18n.properties"
            }
        },
        "services": {
            "ShellUIService": {
                "factoryName": "sap.ushell.ui5service.ShellUIService",
                "lazy": false,
                "settings": {
                    "setTitle": "auto",
                    "setHierarchy": "auto"
                }
            }
        },
        "routing": {
            "config": {},
            "routes": [
                {
                    "pattern": ":?query:",
                    "name": "GrantsList",
                    "target": "GrantsList"
                },
                {
                    "pattern": "GrantsMasterData({key}):?query:",
                    "name": "GrantsObjectPage",
                    "target": "GrantsObjectPage"
                },
                {
                    "pattern": "GrantApplication/{grantId}",
                    "name": "GrantApplication",
                    "target": "GrantApplication"
                }
            ],
            "targets": {
                "GrantsList": {
                    "type": "Component",
                    "id": "GrantsList",
                    "name": "sap.fe.templates.ListReport",
                    "options": {
                        "settings": {
                            "contextPath": "/GrantsMasterData",
                            "enhanceI18n": "i18n/i18n.properties",
                            "variantManagement": "Page",
                            "navigation": {
                                "GrantsMasterData": {
                                    "detail": {
                                        "route": "GrantsObjectPage"
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "type": "GridTable"
                                    }
                                }
                            },
                            "initialLoad": "Enabled"
                        }
                    }
                },
                "GrantsObjectPage": {
                    "title": "{i18n>Grant}",
                    "type": "Component",
                    "id": "GrantsObjectPage",
                    "name": "sap.fe.templates.ObjectPage",
                    "options": {
                        "settings": {
                            "contextPath": "/GrantsMasterData",
                            "editableHeaderContent": false,
                            "content": {
                                "header": {
                                    "actions": {
                                        "ApplyForGrantBtn": {
                                            "id": "ApplyForGrantBtn",
                                            "text": "{i18n>ApplyGrant}",
                                            "press": "grants.campusgrantflow.ext.controller.ObjectPageExt.applyForGrant",
                                            "visible": "{= !${ui>/isEditable} }"
                                        }
                                    }
                                }
                            },
                            "controlConfiguration": {
                                "documents/@com.sap.vocabularies.UI.v1.LineItem": {
                                    "tableSettings": {
                                        "selectionMode": "Multi",
                                        "type": "ResponsiveTable"
                                    },
                                    "actions": {
                                        "UploadDocument": {
                                            "enabled": "{ui>/isEditable}",
                                            "position": {
                                                "anchor": "StandardAction::Delete",
                                                "placement": "Before"
                                            },
                                            "press": "grants.campusgrantflow.ext.controller.DocumentActions.upload",
                                            "text": "{i18n>DocumentUpload}",
                                            "visible": "{ui>/isEditable}"
                                        }
                                    },
                                    "columns": {
                                        "DocumentActionColumn": {
                                            "header": "{i18n>DocumentAction}",
                                            "horizontalAlign": "Center",
                                            "position": {
                                                "anchor": "DataField::createdBy",
                                                "placement": "After"
                                            },
                                            "template": "grants.campusgrantflow.ext.fragment.DocumentActionColumn",
                                            "width": "6rem"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "GrantApplication": {
                    "type": "View",
                    "id": "GrantApplication",
                    "name": "grants.campusgrantflow.ext.wizard.GrantApplicationWizard",
                    "title": "{i18n>ApplyGrant}"
                }
            }
        }
    },
    "sap.fiori": {
        "registrationIds": [],
        "archeType": "transactional"
    },
    "sap.fe": {
        "app": {
            "hideDraft": {
                "enabled": true
            }
        }
    },
    "sap.cloud": {
        "public": true,
        "service": "campusgrantflow.service"
    }
}
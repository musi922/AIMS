{
  "overrides": [
    {
      "files": ".nvmrc",
      "options": {
        "parser": "yaml"
      }
    }
  ],
  "plugins": ["prettier-plugin-curly", "prettier-plugin-sh", "prettier-plugin-packagejson", "@prettier/plugin-xml"],
  "trailingComma": "all",
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "arrowParens": "always",
  "quoteProps": "as-needed",
  "proseWrap": "preserve",
  "useTabs": false,
  "tabWidth": 2,
  "bracketSameLine": false,
  "singleAttributePerLine": false,
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto"
}
